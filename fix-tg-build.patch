diff --git a/.github/workflows/build-and-relis.yml b/.github/workflows/build-and-relis.yml
index 63c0b44..ac4f8d5 100644
--- a/.github/workflows/build-and-relis.yml
+++ b/.github/workflows/build-and-relis.yml
@@ -66,7 +66,14 @@ jobs:
 
           NON_HOT=$(echo "$NON_IGNORED" | grep -Ev "$HOT_REGEX" || true)
 
-          if [[ -z "$NON_HOT" ]]; then
+          # static/tg (интерфейс Telegram Web K, ~3000 файлов) под HOT_REGEX
+          # формально подпадает (static/.*), но через OTA его не доставить:
+          # generate-ota-manifest.sh его не включает, а у GitHub Release лимит
+          # на число ассетов. Поэтому любое изменение static/tg — это полная
+          # пересборка, иначе в APK/exe новый интерфейс просто не попадёт.
+          TG_CHANGED=$(echo "$NON_IGNORED" | grep -E '^static/tg/' || true)
+
+          if [[ -z "$NON_HOT" && -z "$TG_CHANGED" ]]; then
             echo "hot_only=true" >> "$GITHUB_OUTPUT"
           else
             echo "hot_only=false" >> "$GITHUB_OUTPUT"
@@ -330,6 +337,7 @@ jobs:
             --add-data "static/manifest.json;static" `
             --add-data "static/assets/favorite.png;static" `
             --add-data "static/loading.gif;static" `
+            --add-data "static/tg;static/tg" `
             desktop_launcher.py
 
       - name: Upload Windows artifact
diff --git a/.gitignore b/.gitignore
index e0fee2e..c9b0c60 100644
--- a/.gitignore
+++ b/.gitignore
@@ -18,3 +18,5 @@ google-services.json
 # (см. android/app/build.gradle, flavor "fcm"), коммитится как есть.
 !android/app/src/fcm/google-services.json
 .patch-backup/
+# Копия static/tg, которую раскладывает scripts/sync-android-python.sh (≈56 МБ)
+android/app/src/main/python/tg/
diff --git a/scripts/sync-android-python.sh b/scripts/sync-android-python.sh
index d6dbcb0..5682fcf 100644
--- a/scripts/sync-android-python.sh
+++ b/scripts/sync-android-python.sh
@@ -24,6 +24,17 @@ cp static/manifest.json "$DEST/manifest.json"
 cp static/loading.gif "$DEST/loading.gif"
 cp -r static/assets/. "$DEST/assets"
 
+# Интерфейс /tg/ (Telegram Web K, ~3000 файлов). bridge.py раздаёт его из
+# <папка bridge.py>/tg, поэтому в Android-сборке он должен лежать в $DEST/tg.
+# Сначала чистим старую копию: имена файлов в сборке хэшированные
+# (index-CnT2cwDd.js и т.п.), и при обновлении tweb старые файлы
+# иначе остались бы в APK мусором.
+echo "[sync] Копирую static/tg -> $DEST/tg (интерфейс /tg/)"
+rm -rf "$DEST/tg"
+mkdir -p "$DEST/tg"
+cp -r static/tg/. "$DEST/tg"
+test -f "$DEST/tg/index.html" || { echo "[sync] ОШИБКА: $DEST/tg/index.html не найден после копирования" >&2; exit 1; }
+
 DEST_ASSETS="android/app/src/main/assets"
 echo "[sync] Копирую loading.gif -> $DEST_ASSETS/loading.gif (нативный Android assets, читает GifView.kt через context.assets)"
 mkdir -p "$DEST_ASSETS"
