<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <com.suscersal.maxclient.GifView
            android:id="@+id/loadingGif"
            android:layout_width="96dp"
            android:layout_height="96dp" />

        <!--
            Ширина, minLines и gravity зафиксированы заранее, и текст никогда
            не пустой (см. MainActivity.onCreate) — благодаря этому высота
            блока не меняется, пока сменяются статусы загрузки, и LinearLayout
            не перекомпоновывается/не "прыгает" поверх гифки при смене текста.
        -->
        <TextView
            android:id="@+id/loadingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Загрузка…"
            android:textSize="14sp"
            android:minLines="2"
            android:gravity="center"
            android:textAlignment="center" />

    </LinearLayout>

</FrameLayout>